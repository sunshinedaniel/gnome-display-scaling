msgid "Scaling"
msgstr "Skalowanie"

msgid "Reading display..."
msgstr "Odczytywanie ekranu..."

msgid "Choose display scale"
msgstr "Wybierz skalę ekranu"

msgid "Display Scale Toggle"
msgstr "Przełącznik skali ekranu"

#, javascript-format
msgid "Off: %s"
msgstr "Wyłączone: %s"

msgid "Display unavailable"
msgstr "Ekran niedostępny"

msgid "Applying..."
msgstr "Stosowanie..."

#, javascript-format
msgid "Off: %s  |  On: %s"
msgstr "Wyłączone: %s  |  Włączone: %s"

msgid "This display mode does not support the required 100% off state."
msgstr "Ten tryb ekranu nie obsługuje skali 100% wymaganej po wyłączeniu."

#, javascript-format
msgid "The display reports %s instead of %s."
msgstr "Ekran zgłasza %s zamiast %s."

msgid "Could not change display scaling"
msgstr "Nie można zmienić skali ekranu"

msgid "This tile supports one active display or one mirrored display group. Use Displays settings for extended desktops."
msgstr "Ten przycisk obsługuje jeden aktywny ekran lub jedną grupę powielonych ekranów. W przypadku rozszerzonego pulpitu użyj ustawień ekranów."

#, javascript-format
msgid "Display %s is no longer connected."
msgstr "Ekran %s nie jest już podłączony."

#, javascript-format
msgid "Cannot determine the current mode of %s."
msgstr "Nie można określić bieżącego trybu ekranu %s."

msgid "No active display is available."
msgstr "Brak aktywnego ekranu."

#, javascript-format
msgid "%s is not supported by the current display mode."
msgstr "Bieżący tryb ekranu nie obsługuje %s."
