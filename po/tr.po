msgid "Scaling"
msgstr "Ölçek"

msgid "Reading display..."
msgstr "Ekran bilgileri okunuyor..."

msgid "Choose display scale"
msgstr "Ekran ölçeğini seç"

msgid "Display Scale Toggle"
msgstr "Ekran Ölçeği Değiştirici"

#, javascript-format
msgid "Off: %s"
msgstr "Kapalı: %s"

msgid "Display unavailable"
msgstr "Ekran kullanılamıyor"

msgid "Applying..."
msgstr "Uygulanıyor..."

#, javascript-format
msgid "Off: %s  |  On: %s"
msgstr "Kapalı: %s  |  Açık: %s"

msgid "This display mode does not support the required 100% off state."
msgstr "Bu ekran kipi, kapalı durum için gereken 100% ölçeğini desteklemiyor."

#, javascript-format
msgid "The display reports %s instead of %s."
msgstr "Ekranın bildirdiği değer: %s; beklenen değer: %s."

msgid "Could not change display scaling"
msgstr "Ekran ölçeği değiştirilemedi"

msgid "This tile supports one active display or one mirrored display group. Use Displays settings for extended desktops."
msgstr "Bu düğme bir etkin ekranı veya bir yansıtılmış ekran grubunu destekler. Genişletilmiş masaüstleri için Ekran ayarlarını kullanın."

#, javascript-format
msgid "Display %s is no longer connected."
msgstr "%s ekranı artık bağlı değil."

#, javascript-format
msgid "Cannot determine the current mode of %s."
msgstr "%s için geçerli ekran kipi belirlenemiyor."

msgid "No active display is available."
msgstr "Etkin ekran bulunamadı."

#, javascript-format
msgid "%s is not supported by the current display mode."
msgstr "%s, geçerli ekran kipinde desteklenmiyor."
