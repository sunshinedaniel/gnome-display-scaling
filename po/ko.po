msgid "Scaling"
msgstr "배율"

msgid "Reading display..."
msgstr "디스플레이 정보 읽는 중..."

msgid "Choose display scale"
msgstr "디스플레이 배율 선택"

msgid "Display Scale Toggle"
msgstr "디스플레이 배율 전환"

#, javascript-format
msgid "Off: %s"
msgstr "꺼짐: %s"

msgid "Display unavailable"
msgstr "디스플레이를 사용할 수 없음"

msgid "Applying..."
msgstr "적용 중..."

#, javascript-format
msgid "Off: %s  |  On: %s"
msgstr "꺼짐: %s  |  켜짐: %s"

msgid "This display mode does not support the required 100% off state."
msgstr "이 디스플레이 모드는 꺼짐 상태에 필요한 100% 배율을 지원하지 않습니다."

#, javascript-format
msgid "The display reports %s instead of %s."
msgstr "디스플레이가 %s을(를) 보고했지만 요청한 값은 %s입니다."

msgid "Could not change display scaling"
msgstr "디스플레이 배율을 변경할 수 없음"

msgid "This tile supports one active display or one mirrored display group. Use Displays settings for extended desktops."
msgstr "이 버튼은 활성 디스플레이 하나 또는 미러링된 디스플레이 그룹 하나를 지원합니다. 확장 데스크톱에는 디스플레이 설정을 사용하세요."

#, javascript-format
msgid "Display %s is no longer connected."
msgstr "디스플레이 %s이(가) 더 이상 연결되어 있지 않습니다."

#, javascript-format
msgid "Cannot determine the current mode of %s."
msgstr "%s의 현재 디스플레이 모드를 확인할 수 없습니다."

msgid "No active display is available."
msgstr "사용 가능한 활성 디스플레이가 없습니다."

#, javascript-format
msgid "%s is not supported by the current display mode."
msgstr "현재 디스플레이 모드는 %s을(를) 지원하지 않습니다."
