msgid "Scaling"
msgstr "Escala"

msgid "Reading display..."
msgstr "Leyendo la pantalla..."

msgid "Choose display scale"
msgstr "Elegir la escala de la pantalla"

msgid "Display Scale Toggle"
msgstr "Alternar escala de pantalla"

#, javascript-format
msgid "Off: %s"
msgstr "Desactivado: %s"

msgid "Display unavailable"
msgstr "Pantalla no disponible"

msgid "Applying..."
msgstr "Aplicando..."

#, javascript-format
msgid "Off: %s  |  On: %s"
msgstr "Desactivado: %s  |  Activado: %s"

msgid "This display mode does not support the required 100% off state."
msgstr "Este modo de pantalla no admite la escala del 100% necesaria al desactivar."

#, javascript-format
msgid "The display reports %s instead of %s."
msgstr "La pantalla indica %s en lugar de %s."

msgid "Could not change display scaling"
msgstr "No se pudo cambiar la escala de la pantalla"

msgid "This tile supports one active display or one mirrored display group. Use Displays settings for extended desktops."
msgstr "Este botón admite una pantalla activa o un grupo de pantallas duplicadas. Para escritorios extendidos, utilice la configuración de pantallas."

#, javascript-format
msgid "Display %s is no longer connected."
msgstr "La pantalla %s ya no está conectada."

#, javascript-format
msgid "Cannot determine the current mode of %s."
msgstr "No se puede determinar el modo actual de %s."

msgid "No active display is available."
msgstr "No hay ninguna pantalla activa disponible."

#, javascript-format
msgid "%s is not supported by the current display mode."
msgstr "El modo de pantalla actual no admite %s."
