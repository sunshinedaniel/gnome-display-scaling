msgid "Scaling"
msgstr "拡大率"

msgid "Reading display..."
msgstr "ディスプレイ情報を取得中..."

msgid "Choose display scale"
msgstr "ディスプレイの拡大率を選択"

msgid "Display Scale Toggle"
msgstr "ディスプレイ拡大率の切り替え"

#, javascript-format
msgid "Off: %s"
msgstr "オフ: %s"

msgid "Display unavailable"
msgstr "ディスプレイを利用できません"

msgid "Applying..."
msgstr "適用中..."

#, javascript-format
msgid "Off: %s  |  On: %s"
msgstr "オフ: %s  |  オン: %s"

msgid "This display mode does not support the required 100% off state."
msgstr "現在の表示モードは、オフ時に必要な100%の拡大率に対応していません。"

#, javascript-format
msgid "The display reports %s instead of %s."
msgstr "ディスプレイの拡大率は%sです。要求された値は%sです。"

msgid "Could not change display scaling"
msgstr "ディスプレイの拡大率を変更できませんでした"

msgid "This tile supports one active display or one mirrored display group. Use Displays settings for extended desktops."
msgstr "このボタンは、1台の有効なディスプレイまたは1組のミラーリングされたディスプレイに対応しています。拡張デスクトップにはディスプレイ設定を使用してください。"

#, javascript-format
msgid "Display %s is no longer connected."
msgstr "ディスプレイ%sは接続されていません。"

#, javascript-format
msgid "Cannot determine the current mode of %s."
msgstr "%sの現在の表示モードを取得できません。"

msgid "No active display is available."
msgstr "有効なディスプレイがありません。"

#, javascript-format
msgid "%s is not supported by the current display mode."
msgstr "現在の表示モードは%sに対応していません。"
