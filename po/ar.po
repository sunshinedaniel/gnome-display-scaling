msgid "Scaling"
msgstr "التحجيم"

msgid "Reading display..."
msgstr "جارٍ قراءة إعدادات الشاشة..."

msgid "Choose display scale"
msgstr "اختيار مقياس العرض"

msgid "Display Scale Toggle"
msgstr "تبديل مقياس العرض"

#, javascript-format
msgid "Off: %s"
msgstr "إيقاف: %s"

msgid "Display unavailable"
msgstr "الشاشة غير متاحة"

msgid "Applying..."
msgstr "جارٍ التطبيق..."

#, javascript-format
msgid "Off: %s  |  On: %s"
msgstr "إيقاف: %s  |  تشغيل: %s"

msgid "This display mode does not support the required 100% off state."
msgstr "وضع العرض هذا لا يدعم مقياس 100% المطلوب عند الإيقاف."

#, javascript-format
msgid "The display reports %s instead of %s."
msgstr "تشير الشاشة إلى %s بدلاً من %s."

msgid "Could not change display scaling"
msgstr "تعذّر تغيير مقياس العرض"

msgid "This tile supports one active display or one mirrored display group. Use Displays settings for extended desktops."
msgstr "يدعم هذا الزر شاشة نشطة واحدة أو مجموعة شاشات متطابقة. استخدم إعدادات الشاشات لأسطح المكتب الممتدة."

#, javascript-format
msgid "Display %s is no longer connected."
msgstr "لم تعد الشاشة %s متصلة."

#, javascript-format
msgid "Cannot determine the current mode of %s."
msgstr "تعذّر تحديد وضع العرض الحالي للشاشة %s."

msgid "No active display is available."
msgstr "لا توجد شاشة نشطة متاحة."

#, javascript-format
msgid "%s is not supported by the current display mode."
msgstr "مقياس %s غير مدعوم في وضع العرض الحالي."
