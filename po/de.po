msgid "Scaling"
msgstr "Skalierung"

msgid "Reading display..."
msgstr "Anzeige wird gelesen..."

msgid "Choose display scale"
msgstr "Anzeigeskalierung auswählen"

msgid "Display Scale Toggle"
msgstr "Anzeigeskalierung umschalten"

#, javascript-format
msgid "Off: %s"
msgstr "Aus: %s"

msgid "Display unavailable"
msgstr "Anzeige nicht verfügbar"

msgid "Applying..."
msgstr "Wird angewendet..."

#, javascript-format
msgid "Off: %s  |  On: %s"
msgstr "Aus: %s  |  Ein: %s"

msgid "This display mode does not support the required 100% off state."
msgstr "Dieser Anzeigemodus unterstützt die erforderliche Skalierung von 100% im ausgeschalteten Zustand nicht."

#, javascript-format
msgid "The display reports %s instead of %s."
msgstr "Die Anzeige meldet %s statt %s."

msgid "Could not change display scaling"
msgstr "Anzeigeskalierung konnte nicht geändert werden"

msgid "This tile supports one active display or one mirrored display group. Use Displays settings for extended desktops."
msgstr "Diese Kachel unterstützt eine aktive Anzeige oder eine Gruppe gespiegelter Anzeigen. Verwenden Sie für erweiterte Desktops die Anzeigeeinstellungen."

#, javascript-format
msgid "Display %s is no longer connected."
msgstr "Die Anzeige %s ist nicht mehr verbunden."

#, javascript-format
msgid "Cannot determine the current mode of %s."
msgstr "Der aktuelle Anzeigemodus von %s konnte nicht ermittelt werden."

msgid "No active display is available."
msgstr "Keine aktive Anzeige verfügbar."

#, javascript-format
msgid "%s is not supported by the current display mode."
msgstr "%s wird vom aktuellen Anzeigemodus nicht unterstützt."
