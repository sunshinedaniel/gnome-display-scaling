msgid "Scaling"
msgstr "มาตราส่วน"

msgid "Reading display..."
msgstr "กำลังอ่านข้อมูลจอแสดงผล..."

msgid "Choose display scale"
msgstr "เลือกมาตราส่วนจอแสดงผล"

msgid "Display Scale Toggle"
msgstr "สลับมาตราส่วนจอแสดงผล"

#, javascript-format
msgid "Off: %s"
msgstr "ปิด: %s"

msgid "Display unavailable"
msgstr "ไม่สามารถใช้จอแสดงผลได้"

msgid "Applying..."
msgstr "กำลังใช้การตั้งค่า..."

#, javascript-format
msgid "Off: %s  |  On: %s"
msgstr "ปิด: %s  |  เปิด: %s"

msgid "This display mode does not support the required 100% off state."
msgstr "โหมดจอแสดงผลนี้ไม่รองรับมาตราส่วน 100% ที่จำเป็นเมื่อปิด"

#, javascript-format
msgid "The display reports %s instead of %s."
msgstr "จอแสดงผลรายงาน %s แทนที่จะเป็น %s"

msgid "Could not change display scaling"
msgstr "ไม่สามารถเปลี่ยนมาตราส่วนจอแสดงผลได้"

msgid "This tile supports one active display or one mirrored display group. Use Displays settings for extended desktops."
msgstr "ปุ่มนี้รองรับจอแสดงผลที่ใช้งานอยู่หนึ่งจอหรือกลุ่มจอแสดงผลแบบสะท้อนหนึ่งกลุ่ม สำหรับเดสก์ท็อปแบบขยาย ให้ใช้การตั้งค่าจอแสดงผล"

#, javascript-format
msgid "Display %s is no longer connected."
msgstr "จอแสดงผล %s ไม่ได้เชื่อมต่อแล้ว"

#, javascript-format
msgid "Cannot determine the current mode of %s."
msgstr "ไม่สามารถระบุโหมดปัจจุบันของ %s ได้"

msgid "No active display is available."
msgstr "ไม่มีจอแสดงผลที่ใช้งานอยู่"

#, javascript-format
msgid "%s is not supported by the current display mode."
msgstr "โหมดจอแสดงผลปัจจุบันไม่รองรับ %s"
