msgid "Scaling"
msgstr "Масштаб"

msgid "Reading display..."
msgstr "Чтение параметров экрана..."

msgid "Choose display scale"
msgstr "Выбрать масштаб экрана"

msgid "Display Scale Toggle"
msgstr "Переключатель масштаба экрана"

#, javascript-format
msgid "Off: %s"
msgstr "Выключено: %s"

msgid "Display unavailable"
msgstr "Экран недоступен"

msgid "Applying..."
msgstr "Применение..."

#, javascript-format
msgid "Off: %s  |  On: %s"
msgstr "Выключено: %s  |  Включено: %s"

msgid "This display mode does not support the required 100% off state."
msgstr "Этот режим экрана не поддерживает масштаб 100%, необходимый при выключении."

#, javascript-format
msgid "The display reports %s instead of %s."
msgstr "Экран сообщает масштаб %s вместо %s."

msgid "Could not change display scaling"
msgstr "Не удалось изменить масштаб экрана"

msgid "This tile supports one active display or one mirrored display group. Use Displays settings for extended desktops."
msgstr "Эта кнопка поддерживает один активный экран или одну группу зеркальных экранов. Для расширенного рабочего стола используйте настройки экранов."

#, javascript-format
msgid "Display %s is no longer connected."
msgstr "Экран %s больше не подключён."

#, javascript-format
msgid "Cannot determine the current mode of %s."
msgstr "Не удалось определить текущий режим экрана %s."

msgid "No active display is available."
msgstr "Нет доступного активного экрана."

#, javascript-format
msgid "%s is not supported by the current display mode."
msgstr "Текущий режим экрана не поддерживает %s."
