msgid "Scaling"
msgstr "پیمانہ"

msgid "Reading display..."
msgstr "ڈسپلے کی معلومات پڑھی جا رہی ہیں..."

msgid "Choose display scale"
msgstr "ڈسپلے کا پیمانہ منتخب کریں"

msgid "Display Scale Toggle"
msgstr "ڈسپلے پیمانہ تبدیل کریں"

#, javascript-format
msgid "Off: %s"
msgstr "بند: %s"

msgid "Display unavailable"
msgstr "ڈسپلے دستیاب نہیں"

msgid "Applying..."
msgstr "لاگو کیا جا رہا ہے..."

#, javascript-format
msgid "Off: %s  |  On: %s"
msgstr "بند: %s  |  فعال: %s"

msgid "This display mode does not support the required 100% off state."
msgstr "یہ ڈسپلے موڈ بند حالت کے لیے ضروری 100% پیمانے کی حمایت نہیں کرتا۔"

#, javascript-format
msgid "The display reports %s instead of %s."
msgstr "ڈسپلے %s دکھا رہا ہے، جبکہ مطلوبہ قدر %s ہے۔"

msgid "Could not change display scaling"
msgstr "ڈسپلے کا پیمانہ تبدیل نہیں کیا جا سکا"

msgid "This tile supports one active display or one mirrored display group. Use Displays settings for extended desktops."
msgstr "یہ بٹن ایک فعال ڈسپلے یا آئینہ دار ڈسپلے کے ایک گروپ کی حمایت کرتا ہے۔ توسیع شدہ ڈیسک ٹاپ کے لیے ڈسپلے کی ترتیبات استعمال کریں۔"

#, javascript-format
msgid "Display %s is no longer connected."
msgstr "ڈسپلے %s اب منسلک نہیں ہے۔"

#, javascript-format
msgid "Cannot determine the current mode of %s."
msgstr "%s کا موجودہ ڈسپلے موڈ معلوم نہیں کیا جا سکا۔"

msgid "No active display is available."
msgstr "کوئی فعال ڈسپلے دستیاب نہیں۔"

#, javascript-format
msgid "%s is not supported by the current display mode."
msgstr "موجودہ ڈسپلے موڈ میں %s کی حمایت نہیں ہے۔"
