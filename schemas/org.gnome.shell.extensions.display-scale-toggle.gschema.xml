<schemalist>
  <schema id="org.gnome.shell.extensions.display-scale-toggle" path="/org/gnome/shell/extensions/display-scale-toggle/">
    <key name="preferred-scale" type="d">
      <default>2.0</default>
      <range min="1.0" max="8.0"/>
      <summary>Scale used when the tile is on</summary>
      <description>Remembered independently of the off state, which always uses 100%.</description>
    </key>
  </schema>
</schemalist>
